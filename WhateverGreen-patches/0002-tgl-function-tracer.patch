+		bool routing {false};
+
+		/**
+		 *  Panic with the hook status once the framebuffer kext is patched
+		 */
+		bool selfTest {false};
+
+		/**
+		 *  Number of resolved and routed functions
+		 */
+		size_t resolved {0};
+		size_t routed {0};
+
+		/**
+		 *  Wrapper for traced function I

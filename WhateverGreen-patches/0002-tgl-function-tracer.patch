+		template <size_t I>
+		static uint64_t wrapFunction(uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t a4, uint64_t a5);
+
+		/**
+		 *  Called on entry to and after the return of traced function i, stopping if requested

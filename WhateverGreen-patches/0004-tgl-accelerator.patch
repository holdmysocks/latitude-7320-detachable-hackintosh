+void IGFX::TigerLakeRegisterMap::csbThread(thread_call_param_t param0, thread_call_param_t) {
+	// Kernel thread context. Same scheme as traceThread: one synchronous write of the whole record, file left open.
+	auto self = static_cast<TigerLakeRegisterMap *>(param0);
+	if (!self->csbContext)
+		self->csbContext = vfs_context_create(nullptr);
+	auto ctx = static_cast<vfs_context_t>(self->csbContext);
+	if (!self->csbVnode && ctx) {
+		vnode_t vp = NULLVP;
+		if (vnode_open("/Users/Shared/tgl-csb.bin", O_WRONLY | O_CREAT, 0666, VNODE_LOOKUP_NOFOLLOW, &vp, ctx) == 0)
+			self->csbVnode = vp;
+	}
+	if (self->csbVnode && ctx) {
+		self->csbRec.flushes++;
+		self->csbRec.nowMs = tglUptimeMilliseconds();
+		uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+		if (uio) {
+			uio_addiov(uio, CAST_USER_ADDR_T(&self->csbRec), sizeof(self->csbRec));
+			VNOP_WRITE(static_cast<vnode_t>(self->csbVnode), uio, IO_SYNC, ctx);
+		}
+	}
+}

+void IGFX::TigerLakeRegisterMap::probeGTFuses(void *controller) {
+	// What IntelAccelerator::getGPUInfo() reads straight from the MMIO mapping, in its order, plus a few neighbours
+	static const uint32_t regs[GTFuseRecord::Count] = {
+		0x145948, 0x145994, 0x145998, 0x229C, 0x7008, 0x7000, 0x7004, 0x9138, 0x913C, 0x9134,
+		0x911C, 0x9120, 0x9118, 0x9140, 0x0D00, 0x9130, 0x9144, 0x9148, 0xA188, 0xA278
+	};
+	// The driver's own ReadRegister32 refuses 0x2000-0x3FFFF while its "GT not accessible" flag is set, so these go
+	// straight to the mapping it keeps at this+0x9B8 (size at this+0xC38) in AppleIntelICLLPGraphicsFramebuffer 24.0.5.
+	auto base = *reinterpret_cast<volatile uint8_t **>(static_cast<uint8_t *>(controller) + 0x9B8);
+	uint32_t size = *reinterpret_cast<uint32_t *>(static_cast<uint8_t *>(controller) + 0xC38);
+	gtFusesDone = true;
+	gtFuses.uptime = tglUptimeSeconds();
+	if (!base || size < 0x200000) {
+		gtFuses.waited[0] = gtFuses.waited[1] = 0xDEAD;
+		gtFuses.reg[0].address = size;
+		if (gtFuseCall)
+			thread_call_enter1(gtFuseCall, nullptr);
+		return;
+	}
+	auto rd = [&](void *, uint32_t a) -> uint32_t { return *reinterpret_cast<volatile uint32_t *>(base + a); };
+	auto wr = [&](void *, uint32_t a, uint32_t v) { *reinterpret_cast<volatile uint32_t *>(base + a) = v; };
+	for (uint32_t i = 0; i < GTFuseRecord::Count; i++) {
+		gtFuses.reg[i].address = regs[i];
+		gtFuses.reg[i].plain = rd(controller, regs[i]);
+	}
+	// Forcewake, as i915 does it on Gen11/12: masked write of bit 0, then wait for bit 0 of the ack register.
+	// Render: request 0xA278, ack 0x0D84. GT: request 0xA188, ack 0x130044.
+	static const uint32_t req[2] = {0xA278, 0xA188}, ack[2] = {0x0D84, 0x130044};
+	for (uint32_t d = 0; d < 2; d++) {
+		gtFuses.ackBefore[d] = rd(controller, ack[d]);
+		wr(controller, req[d], 0x00010001);
+		uint32_t n = 0;
+		while (!(rd(controller, ack[d]) & 1) && n < 500) {
+			IODelay(100);
+			n++;
+		}
+		gtFuses.waited[d] = n;
+		gtFuses.ackAfter[d] = rd(controller, ack[d]);
+	}
+	for (uint32_t i = 0; i < GTFuseRecord::Count; i++)
+		gtFuses.reg[i].awake = rd(controller, regs[i]);
+	// Release only what was not already held when we came
+	for (uint32_t d = 0; d < 2; d++)
+		if (!(gtFuses.ackBefore[d] & 1))
+			wr(controller, req[d], 0x00010000);
+	if (gtFuseCall)
+		thread_call_enter1(gtFuseCall, nullptr);
 }
 

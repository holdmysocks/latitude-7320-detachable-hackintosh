+void IGFX::TigerLakeRegisterMap::processGraphicsKext(KernelPatcher &patcher, size_t index, mach_vm_address_t address, size_t size) {
+	// AppleIntelICLGraphics 24.0.5, IntelAccelerator::getGPUInfo():
+	//   movl %r15d, %eax ; notl %eax ; popcntl %eax, %esi ; movl %esi, 0x1188(%rbx)
+	// NumSubSlices = popcount(~[0x913C]). On Ice Lake that register is a subslice DISABLE mask with the unused bits set.
+	// On Tiger Lake it is the dual-subslice ENABLE mask (0x1F on the i5-1140G7), the result is 27, and the driver
+	// panics with "Unsupported ICL Sku". The kext lives in the system kernel collection, where OpenCore's
+	// Kernel/Patch and Kernel/Block do not reach, so it is patched here when it loads.
+	if (csbMode && csbCall) {
+		// The four handlers the driver dispatches to, in the order of its table pfnCsbProcessContextSwitchType
+		static const char *handlers[4] = {
+			"__ZN26IGHardwareCommandStreamer522csbProcessIdleToActiveEPK28SGfxContextStatusBufferEntry",
+			"__ZN26IGHardwareCommandStreamer519csbProcessPreemptedEPK28SGfxContextStatusBufferEntry",
+			"__ZN26IGHardwareCommandStreamer523csbProcessElementSwitchEPK28SGfxContextStatusBufferEntry",
+			"__ZN26IGHardwareCommandStreamer522csbProcessActiveToIdleEPK28SGfxContextStatusBufferEntry"
+		};
+		csbRec.hooked = 1;
+		for (size_t i = 0; i < arrsize(handlers); i++) {
+			csbHandlers[i] = reinterpret_cast<CsbHandler>(patcher.solveSymbol(index, handlers[i], address, size));
+			if (!csbHandlers[i]) {
+				SYSLOG("igfx", "TGLMAP: cannot resolve %s (%d).", handlers[i], patcher.getError());
+				patcher.clearError();
+				csbRec.hooked = 2;
+			}
+		}
+		if (csbRec.hooked == 1) {
+			KernelPatcher::RouteRequest request("__ZN26IGHardwareCommandStreamer526processContextStatusBufferEj", wrapProcessContextStatusBuffer, orgProcessContextStatusBuffer);
+			if (!patcher.routeMultiple(index, &request, 1, address, size)) {
+				SYSLOG("igfx", "TGLMAP: cannot route processContextStatusBuffer (%d).", patcher.getError());
+				patcher.clearError();
+				csbRec.hooked = 3;
+			} else {
+				SYSLOG("igfx", "TGLMAP: reading the context status buffer in the Gen12 layout.");
+			}
+		}
+		// Put the outcome on disk even if the reader is never called. The data volume is not mounted this early.
+		uint64_t deadline = 0;
+		clock_interval_to_deadline(15, kSecondScale, &deadline);
+		thread_call_enter_delayed(csbCall, deadline);
+	}
+	if (accelSubSlices == 0 || accelSubSlices > 8)
+		return;
+	static const uint8_t find[] = {0x44, 0x89, 0xF8, 0xF7, 0xD0, 0xF3, 0x0F, 0xB8, 0xF0, 0x89, 0xB3, 0x88, 0x11, 0x00, 0x00};
+	static uint8_t repl[]       = {0x44, 0x89, 0xF8, 0xBE, 0x00, 0x00, 0x00, 0x00, 0x90, 0x89, 0xB3, 0x88, 0x11, 0x00, 0x00};
+	repl[4] = static_cast<uint8_t>(accelSubSlices);
+	KernelPatcher::LookupPatch patch {};
+	patch.kext = callbackIGFX->currentGraphics;
+	patch.find = find;
+	patch.replace = repl;
+	patch.size = sizeof(find);
+	patch.count = 1;
+	patcher.applyLookupPatch(&patch, reinterpret_cast<uint8_t *>(address), size);
+	if (patcher.getError() != KernelPatcher::Error::NoError) {
+		SYSLOG("igfx", "TGLMAP: getGPUInfo subslice patch failed (%d).", patcher.getError());
+		patcher.clearError();
+	} else {
+		SYSLOG("igfx", "TGLMAP: IntelAccelerator::getGPUInfo will report %u subslices.", accelSubSlices);
+	}
+}

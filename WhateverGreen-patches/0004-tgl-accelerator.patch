+// Render engine registers saved with each hang record
+static const uint32_t tglHangRegisters[16] = {
+	0x2140, 0x2168, 0x2270, 0x2274, 0x2074, 0x2068, 0x2034, 0x2030,
+	0x2038, 0x206C, 0x229C, 0x20C8, 0x2180, 0x2234, 0x7100, 0x20B0
+};
+
+/**
+ *  Read physical memory. Kernel memory handed to the GPU is ordinary RAM; a physical-address descriptor needs no
+ *  mapping and no prepare().
+ */
+/**
+ *  Graphics stolen memory (DSM). The GPU's page tables point unmapped ranges at a placeholder page there, and the
+ *  CPU must not touch it: a read through the kernel's physical map raised a machine check (run GA10, address
+ *  0x6C800000). Every physical access below refuses this range.
+ */
+static uint64_t tglStolenBase = 0, tglStolenSize = 0;
+
+static bool tglPhysicalAllowed(uint64_t address, size_t length) {
+	// RAM only: below the stolen memory (which sits just under the PCI hole) or between 4 GB and 16 GB. Stolen
+	// memory, the PCI hole and anything a stray page-table entry might name above the installed memory are out.
+	if (tglStolenSize == 0 || address < 0x100000)
+		return false;
+	if (address + length <= tglStolenBase)
+		return true;
+	return address >= 0x100000000ULL && address + length <= 0x400000000ULL;
+}
+
+/**
+ *  Find the stolen memory range from the MMIO mirrors of the PCI registers (i915: GEN12_DSMBASE 0x1080C0,
+ *  GGC 0x108040; GMS 0xF0.. = 4 MB steps). Until this has run no physical access is made.
+ */
+static void tglFindStolen(volatile uint8_t *mmio) {
+	if (tglStolenSize != 0 || !mmio)
+		return;
+	uint64_t base = *reinterpret_cast<volatile uint64_t *>(mmio + 0x1080C0) & ~0xFFFFFULL;
+	uint32_t gms = (*reinterpret_cast<volatile uint32_t *>(mmio + 0x108040) >> 8) & 0xFF;
+	uint64_t size = gms < 0xF0 ? static_cast<uint64_t>(gms) * 32 * 1048576 : static_cast<uint64_t>(gms - 0xF0 + 1) * 4 * 1048576;
+	// Never trust the register beyond what GA10 showed on this machine (machine check at 0x6C800000)
+	if (base < 0x40000000 || base > 0x6C800000 || size == 0) {
+		base = 0x6C000000;
+		size = 0x8000000;
+	}
+	tglStolenBase = base;
+	tglStolenSize = size;
+}
+
+static bool tglReadPhysical(uint64_t address, void *buffer, size_t length) {
+	if (!tglPhysicalAllowed(address, length))
+		return false;
+	auto md = IOMemoryDescriptor::withPhysicalAddress(static_cast<IOPhysicalAddress>(address), length, kIODirectionOut);
+	if (!md)
+		return false;
+	bool ok = md->readBytes(0, buffer, length) == length;
+	md->release();
+	return ok;
+}
+
+/**
+ *  Walk a 4-level GPU page table (same entry layout as x86-64: bit 0 present, bit 7 large page)
+ */
+static uint64_t tglGpuToPhysical(uint64_t pml4, uint64_t address) {
+	uint64_t table = pml4 & 0x000FFFFFFFFFF000ULL;
+	for (int level = 3; level >= 0; level--) {
+		uint64_t entry = 0;
+		if (!tglReadPhysical(table + ((address >> (12 + 9 * level)) & 0x1FF) * 8, &entry, sizeof(entry)) || !(entry & 1))
+			return 0;
+		if (level > 0 && level < 3 && (entry & 0x80)) {
+			uint64_t mask = (1ULL << (12 + 9 * level)) - 1;
+			uint64_t page = (entry & 0x000FFFFFFFFFF000ULL & ~mask) | (address & mask & ~0xFFFULL);
+			return tglPhysicalAllowed(page, 4096) ? page : 0;
+		}
+		table = entry & 0x000FFFFFFFFFF000ULL;
+	}
+	return tglPhysicalAllowed(table, 4096) ? table : 0;
+}

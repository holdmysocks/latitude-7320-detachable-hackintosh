+void IGFX::TigerLakeRegisterMap::captureHang(void *ring) {
+	// IGHardwareRingBuffer+0x10 = IntelAccelerator, IntelAccelerator+0x1270 = MMIO mapping
+	auto accel = getMember<uint8_t *>(ring, 0x10);
+	auto mmio = getMember<volatile uint8_t *>(accel, 0x1270);
+	if (!accel || !mmio)
+		return;
+	tglFindStolen(mmio);
+	uint32_t slot = static_cast<uint32_t>(OSIncrementAtomic(reinterpret_cast<volatile SInt32 *>(&hangCount)));
+	if (slot >= HangRecord::Records)
+		return;
+	auto &r = hangRec[slot];
+	r.magic = HangRecord::Magic;
+	r.ms = tglUptimeMilliseconds();
+	accelSafeForceWake(accel, true, 7);
+	for (size_t i = 0; i < arrsize(tglHangRegisters); i++)
+		r.reg[i] = *reinterpret_cast<volatile uint32_t *>(mmio + tglHangRegisters[i]);
+	accelSafeForceWake(accel, false, 7);
+
+	uint64_t bbAddr = (static_cast<uint64_t>(r.reg[1] & 0xFFFF) << 32) | r.reg[0];
+	r.pml4 = (static_cast<uint64_t>(r.reg[3]) << 32) | (r.reg[2] & 0xFFFFF000U);
+	r.batchPage = bbAddr & ~0xFFFULL;
+	if (r.pml4 == 0 || r.batchPage == 0)
+		return;
+	for (uint32_t i = 0; i < HangRecord::BatchPages; i++) {
+		uint64_t gpu = r.batchPage - static_cast<uint64_t>(HangRecord::BatchPages - 1 - i) * 4096;
+		r.batchPhys[i] = tglGpuToPhysical(r.pml4, gpu);
+		if (r.batchPhys[i])
+			tglReadPhysical(r.batchPhys[i], r.batch[i], 4096);
+	}
+
+	// The last STATE_BASE_ADDRESS, 3DSTATE_VS and 3DSTATE_PS before BB_ADDR. Pages before the start of the batch
+	// may hold older commands; the last match wins.
+	auto words = reinterpret_cast<const uint32_t *>(r.batch[0]);
+	size_t end = (HangRecord::BatchPages - 1) * 1024 + (bbAddr & 0xFFF) / 4;
+	uint64_t first = r.batchPage - static_cast<uint64_t>(HangRecord::BatchPages - 1) * 4096;
+	uint64_t ksp[2] {};
+	bool have[2] {};
+	for (size_t i = 0; i + 22 <= end; i++) {
+		uint32_t w = words[i];
+		if (w == 0x61010014) {
+			lilu_os_memcpy(r.sbaCmd, &words[i], sizeof(r.sbaCmd));
+			r.sbaAt = first + i * 4;
+			r.instructionBase = ((static_cast<uint64_t>(words[i + 11]) << 32) | words[i + 10]) & ~0xFFFULL;
+		} else if (w == 0x78100007 || (w & 0xFFFFFF00U) == 0x78200000) {
+			int k = w == 0x78100007 ? 0 : 1;
+			lilu_os_memcpy(r.kernelCmd[k], &words[i], sizeof(r.kernelCmd[k]));
+			ksp[k] = ((static_cast<uint64_t>(words[i + 2]) << 32) | words[i + 1]) & ~0x3FULL;
+			have[k] = true;
+		}
+	}
+	for (int k = 0; k < 2; k++) {
+		if (!have[k])
+			continue;
+		r.kernelAt[k] = r.instructionBase + ksp[k];
+		for (uint32_t i = 0; i < HangRecord::KernelPages; i++) {
+			uint64_t phys = tglGpuToPhysical(r.pml4, (r.kernelAt[k] & ~0xFFFULL) + i * 4096ULL);
+			if (i == 0)
+				r.kernelPhys[k] = phys;
+			if (phys)
+				tglReadPhysical(phys, r.kernel[k][i], 4096);
+		}
+	}
 }
 
+static bool tglWritePhysical(uint64_t address, const void *buffer, size_t length) {
+	if (!tglPhysicalAllowed(address, length))
+		return false;
+	auto md = IOMemoryDescriptor::withPhysicalAddress(static_cast<IOPhysicalAddress>(address), length, kIODirectionOut);
+	if (!md)
+		return false;
+	bool ok = md->writeBytes(0, buffer, length) == length;
+	md->release();
+	return ok;
+}
+
+static uint32_t tglHash(const uint8_t *data, size_t length) {
+	uint32_t h = 2166136261U;
+	for (size_t i = 0; i < length; i++)
+		h = (h ^ data[i]) * 16777619U;
+	return h;
+}

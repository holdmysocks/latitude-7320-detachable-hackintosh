+/**
+ *  One dword of a batch, through the context's page tables; the page last read is kept
+ */
+bool IGFX::TigerLakeRegisterMap::xlateDword(uint64_t pml4, uint64_t address, uint32_t &value) {
+	uint64_t page = address & ~0xFFFULL;
+	if (page != xlatePageAt) {
+		xlatePageAt = ~0ULL;
+		uint64_t phys = tglGpuToPhysical(pml4, page);
+		if (!phys || !tglReadPhysical(phys, xlatePage, 4096))
+			return false;
+		xlatePageAt = page;
+	}
+	value = *reinterpret_cast<const uint32_t *>(xlatePage + (address & 0xFFC));
+	return true;
+}
+
+void IGFX::TigerLakeRegisterMap::xlateKernel(uint64_t pml4, uint64_t address, uint32_t command) {
+	auto &rec = *xlateRec;
+	rec.kernelRefs++;
+	// The kernel is read page by page (the pages need not be contiguous physically), two pages first; more only
+	// if the translator says the kernel goes on (image-processing shaders run to hundreds of KB)
+	uint32_t offset = address & 0xFFF;
+	uint32_t have = 0, pagesRead = 0;
+	auto readMore = [&](uint32_t upTo) {
+		for (; pagesRead < upTo && pagesRead < XlatePages; pagesRead++) {
+			uint64_t phys = tglGpuToPhysical(pml4, (address & ~0xFFFULL) + pagesRead * 4096ULL);
+			uint32_t skip = pagesRead == 0 ? offset : 0;
+			if (!phys || !tglReadPhysical(phys + skip, xlateIn + have, 4096 - skip))
+				return false;
+			have += 4096 - skip;
+		}
+		return true;
+	};
+	bool more = readMore(2);
+	if (have == 0) {
+		rec.unmapped++;
+		return;
+	}
+	bzero(xlateIn + have, 8);
+	uint64_t firstPhys = tglGpuToPhysical(pml4, address & ~0xFFFULL);
+	if (*reinterpret_cast<const uint64_t *>(xlateIn) == 0) {
+		rec.empty++;
+		return;
+	}
+
+	// Translated before and unchanged since, or rejected before and unchanged since? (The first 4 KB are compared.)
+	uint64_t key = firstPhys + offset;
+	auto &entry = xlateCache[(key >> 6) % XlateCacheSize];
+	if (entry.key == key && entry.length != 0) {
+		uint32_t length = entry.length & 0x7FFFFFFF;
+		if (length > 4096 - offset)
+			length = 4096 - offset;
+		if (tglHash(xlateIn, length) == entry.hash) {
+			if (entry.length & 0x80000000U)
+				rec.rejectedAgain++;
+			else
+				rec.cacheHits++;
+			return;
+		}
+	}
+
+	tgl_xlate_info info {};
+	int length;
+	for (;;) {
+		length = tgl_xlate_kernel(xlateIn, static_cast<int>(have), xlateOut, &info);
+		if (length > 0 || !info.need_more || !more || pagesRead >= XlatePages)
+			break;
+		more = readMore(pagesRead * 4);
+		if (have + 8 <= XlatePages * 4096)
+			bzero(xlateIn + have, 8);
+	}
+	if (length > 0) {
+		bool ok = true;
+		for (uint32_t i = 0, done = 0; ok && done < static_cast<uint32_t>(length); i++) {
+			uint32_t skip = i == 0 ? offset : 0;
+			uint32_t chunk = static_cast<uint32_t>(length) - done < 4096 - skip ? static_cast<uint32_t>(length) - done : 4096 - skip;
+			uint64_t phys = i < XlatePages ? tglGpuToPhysical(pml4, (address & ~0xFFFULL) + i * 4096ULL) : 0;
+			ok = phys && tglWritePhysical(phys + skip, xlateOut + done, chunk);
+			done += chunk;
+		}
+		if (ok) {
+			entry.key = key;
+			entry.length = static_cast<uint32_t>(length);
+			entry.hash = tglHash(xlateOut, static_cast<uint32_t>(length) < 4096 - offset ? static_cast<size_t>(length) : 4096 - offset);
+			rec.translated++;
+			rec.bytesOut += static_cast<uint32_t>(length);
+			if ((rec.translated & (rec.translated - 1)) == 0)
+				thread_call_enter1(xlateCall, nullptr);
+		}
+		return;
+	}
+
+	rec.rejected++;
+	entry.key = key;
+	entry.length = 0x80000000U | 64;
+	entry.hash = tglHash(xlateIn, 64);
+	if (info.offset < 0)
+		info.offset = 0;
+	if (rec.nfails < XlateRecord::Fails) {
+		auto &f = rec.fail[rec.nfails++];
+		f.ms = tglUptimeMilliseconds();
+		f.command = command;
+		f.offset = static_cast<uint32_t>(info.offset);
+		f.instructions = static_cast<uint32_t>(info.instructions);
+		f.kernelAt = address;
+		if (info.reason)
+			strlcpy(f.reason, info.reason, sizeof(f.reason));
+		uint32_t at = static_cast<uint32_t>(info.offset) < XlatePages * 4096 - sizeof(f.bytes) ? static_cast<uint32_t>(info.offset) : 0;
+		lilu_os_memcpy(f.bytes, xlateIn + at, sizeof(f.bytes));
+		if (rec.nsamples < XlateRecord::Samples)
+			lilu_os_memcpy(rec.sample[rec.nsamples++], xlateIn, 4096);
+	}
+	thread_call_enter1(xlateCall, nullptr);
+}
+
+void IGFX::TigerLakeRegisterMap::xlateBatch(void *ring, uint64_t address) {
+	// IGHardwareRingBuffer+0x20 = IGHardwareContext, +0x98 = its context image (IGSharedMappedBuffer). The image is
+	// the hardware's logical ring context: page 1 holds register offset/value pairs, among them PDP0 (the PML4
+	// with 48-bit addressing).
+	auto &rec = *xlateRec;
+	if (tglStolenSize == 0) {
+		auto accel = getMember<uint8_t *>(ring, 0x10);
+		tglFindStolen(accel ? getMember<volatile uint8_t *>(accel, 0x1270) : nullptr);
+		rec.stolenBaseMB = static_cast<uint32_t>(tglStolenBase >> 20);
+		rec.stolenSizeMB = static_cast<uint32_t>(tglStolenSize >> 20);
+		if (tglStolenSize == 0)
+			return;
+	}
+	auto context = getMember<void *>(ring, 0x20);
+	auto buffer = context ? getMember<void *>(context, 0x98) : nullptr;
+	auto image = buffer ? static_cast<const uint32_t *>(sharedBufferVirtualAddress(buffer)) : nullptr;
+	if (!image) {
+		rec.badImage++;
+		return;
+	}
+	// Find the PDP0 pair instead of trusting one layout: { RING+0x274, high } followed by { RING+0x270, low }.
+	// The standard layout has it at dwords 0x30..0x33.
+	const uint32_t *state = image + 0x1000 / 4;
+	uint32_t found = 0;
+	for (uint32_t i = 0x20; i < 0x40 && !found; i += 2)
+		if ((state[i] & 0xFFF) == 0x274 && (state[i + 2] & 0xFFF) == 0x270 && (state[i] & ~0xFFFU) == (state[i + 2] & ~0xFFFU))
+			found = i;
+	if (!found) {
+		rec.badImage++;
+		return;
+	}
+	if ((state[found] & ~0xFFFU) != 0x2000) {
+		rec.notRender++;
+		return;
+	}
+	uint64_t pml4 = (static_cast<uint64_t>(state[found + 1]) << 32) | (state[found + 3] & 0xFFFFF000U);
+	if (!pml4) {
+		rec.badImage++;
+		return;
+	}
+	rec.walked++;
+	xlatePageAt = ~0ULL;
+
+	static constexpr uint32_t MaxDwords = 96 * 1024;   // 384 KB
+	uint64_t at = address & ~3ULL;
+	uint64_t base = xlateLastBase;
+	bool haveBase = base != 0;
+	uint32_t jumps = 0;
+	bool ended = false;
+	for (uint32_t budget = MaxDwords; budget != 0;) {
+		uint32_t h = 0;
+		if (!xlateDword(pml4, at, h))
+			break;
+		uint32_t type = h >> 29, length = 1;
+		rec.commands++;
+		if (type == 0) {
+			uint32_t opcode = (h >> 23) & 0x3F;
+			if (opcode == 0x0A) {           // MI_BATCH_BUFFER_END
+				ended = true;
+				break;
+			}
+			if (opcode == 0x31) {           // MI_BATCH_BUFFER_START: follow (chained or second level alike)
+				uint32_t lo = 0, hi = 0;
+				if (++jumps > 8 || !xlateDword(pml4, at + 4, lo) || !xlateDword(pml4, at + 8, hi))
+					break;
+				at = ((static_cast<uint64_t>(hi & 0xFFFF) << 32) | lo) & ~3ULL;
+				budget--;
+				continue;
+			}
+			length = opcode < 0x10 ? 1 : (h & 0xFF) + 2;
+		} else if (type == 3) {
+			length = ((h >> 27) & 3) == 1 ? 1 : (h & 0xFF) + 2;
+			uint32_t id = h >> 16;
+			if (id == 0x6101 && length >= 12) {          // STATE_BASE_ADDRESS: instruction base in dwords 10, 11
+				uint32_t lo = 0, hi = 0;
+				if (xlateDword(pml4, at + 40, lo) && xlateDword(pml4, at + 44, hi) && (lo & 1)) {
+					base = ((static_cast<uint64_t>(hi & 0xFFFF) << 32) | lo) & ~0xFFFULL;
+					haveBase = true;
+					xlateLastBase = base;
+				}
+			} else if (id == 0x7810 || id == 0x781B || id == 0x781D || id == 0x7811 || id == 0x7820) {
+				// 3DSTATE_VS / DS / GS / PS: kernel start pointer in dwords 1, 2; PS has two more in 8..11.
+				// 3DSTATE_HS: enable in dword 2 bit 31, kernel start pointer in dwords 3, 4.
+				uint32_t ksp[6] {};
+				bool ok;
+				if (id == 0x781B) {
+					uint32_t enable = 0;
+					ok = xlateDword(pml4, at + 8, enable) && (enable & 0x80000000U) &&
+					     xlateDword(pml4, at + 12, ksp[0]) && xlateDword(pml4, at + 16, ksp[1]);
+				} else {
+					ok = xlateDword(pml4, at + 4, ksp[0]) && xlateDword(pml4, at + 8, ksp[1]);
+				}
+				if (ok && id == 0x7820 && length >= 12)
+					ok = xlateDword(pml4, at + 32, ksp[2]) && xlateDword(pml4, at + 36, ksp[3]) &&
+					     xlateDword(pml4, at + 40, ksp[4]) && xlateDword(pml4, at + 44, ksp[5]);
+				if (ok && !haveBase) {
+					rec.noBase++;
+				} else if (ok) {
+					// 3DSTATE_PS dword 6: bit 0 = 8-pixel dispatch, bit 1 = 16, bit 2 = 32. Kernel 0 serves the 8-pixel
+					// mode (or the only mode enabled), kernel 1 the 32-pixel mode, kernel 2 the 16-pixel mode.
+					uint32_t modes = 7;
+					if (id == 0x7820 && !xlateDword(pml4, at + 24, modes))
+						modes = 7;
+					modes &= 7;
+					bool single = modes == 1 || modes == 2 || modes == 4;
+					for (int k = 0; k < 3; k++) {
+						if (id == 0x7820 && !single && ((k == 0 && !(modes & 1)) || (k == 1 && !(modes & 4)) || (k == 2 && !(modes & 2))))
+							continue;
+						if (id == 0x7820 && single && k != 0)
+							continue;
+						uint64_t pointer = ((static_cast<uint64_t>(ksp[2 * k + 1] & 0xFFFF) << 32) | ksp[2 * k]) & ~0x3FULL;
+						// A stage that is off has a zero pointer; the second and third PS kernels are optional
+						if (k > 0 && (id != 0x7820 || pointer == 0))
+							continue;
+						if (k == 0 && pointer == 0 && id != 0x7820)
+							continue;
+						xlateKernel(pml4, base + pointer, h);
+					}
+					xlatePageAt = ~0ULL;   // xlateKernel does not use the batch page, but keep the walk honest
+				}
+			}
+		} else {
+			break;   // not a render-engine command: lost track of the batch
+		}
+		if (length > budget)
+			break;
+		budget -= length;
+		at += static_cast<uint64_t>(length) * 4;
+	}
+	if (!ended)
+		rec.noEnd++;
+}
